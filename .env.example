# Google Apps Script Webhook for consultations and leads (paste your Web App /exec URL here)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
GOOGLE_APPS_SCRIPT_TOKEN=

# Geocoder endpoint (defaults to https://geocoding-api.open-meteo.com/v1/search)
CELESTIA_GEOCODER_URL=https://geocoding-api.open-meteo.com/v1/search
